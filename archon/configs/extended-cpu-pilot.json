{
  "name": "archon-extended-cpu-pilot-v1",
  "seed": 7331,
  "tokenizer_vocab_target": 320,
  "model": {
    "layers": 2,
    "hidden_size": 64,
    "intermediate_size": 128,
    "attention_heads": 4,
    "key_value_heads": 2,
    "head_dimension": 16,
    "context_length": 64
  },
  "training": {
    "steps": 2000,
    "batch_size": 8,
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "checkpoint_every": 250,
    "device": "cpu",
    "threads": 1
  },
  "data": {
    "path": "archon/data/pilot_corpus.txt",
    "train_fraction": 0.8,
    "validation_fraction": 0.1,
    "test_fraction": 0.1
  }
}
